# Copy to a private .env file and fill in your own values.
PS3_LIBRARY_ROOT=/srv/ps3-library
PS3_INCOMING_DIR=/srv/ps3-library/incoming
PS3_WORK_ROOT=/srv/ps3-library/.iso-build-work
PS3_STATE_ROOT=/srv/ps3-library/.ingest
PS3_IRD_ROOT=/srv/ps3-library/.ingest/irds
PS3_ISO_ROOT=/srv/ps3-library/PS3ISO
PS3_MAKEPS3ISO=/usr/local/lib/ps3-ingest/bin/makeps3iso
PS3_IRD_PARSER_ROOT=/opt/ps3-tools/pyird
PS3_INGEST_COMMAND=/usr/local/sbin/ps3-ingest
APP_STATE_ROOT=/var/lib/ps3-media-automation
WORKER_INTERVAL_SECONDS=5
INGEST_STABLE_SECONDS=30

# Host paths mounted by docker-compose. Replace with paths on your machine.
PS3_HOST_LIBRARY_ROOT=./runtime-library
PS3_HOST_TOOLS_ROOT=./runtime-tools
PS3_CAPACITY_PATHS=Incoming=/srv/ps3-library/incoming,Work=/srv/ps3-library/.iso-build-work,PS3ISO=/srv/ps3-library/PS3ISO
PS3_METADATA_ROOT=/srv/ps3-library/.ingest

# The relay must enforce the idle/game-running check before XMB reload.
PS3_REFRESH_RELAY_URL=http://MEDIA-MANAGEMENT-HOST:PORT/refresh
PS3_REFRESH_RELAY_TOKEN_FILE=/etc/ps3-refresh-relay.token
PS3_REFRESH_PENDING_FILE=/var/lib/ps3-media-automation/refresh-pending.json

# Leave PROWLARR_CONTAINER empty for normal container-to-container HTTP access.
PROWLARR_CONTAINER=
PROWLARR_SEARCH_URL=http://prowlarr:9696/api/v1/search
PROWLARR_URL=http://prowlarr:9696
PROWLARR_PUBLIC_URL=http://SERVER-IP:9696
PROWLARR_API_KEY=YOUR_PROWLARR_API_KEY
PROWLARR_PS3_INDEXER_ID=1
PROWLARR_PS3_INDEXER_NAME=PS3-category-indexer
PROWLARR_PS3_CATEGORY=1080
PROWLARR_NOCATEGORY_INDEXER_ID=2
PROWLARR_NOCATEGORY_INDEXER_NAME=no-category-indexer

# Optional read-only SAB queue monitoring for the Home page.
SAB_URL=http://sabnzbd:8080
SAB_API_KEY=YOUR_SAB_API_KEY
SAB_CATEGORY=ps3
# Optional when SAB's host allow-list expects a different internal hostname.
SAB_HOST_HEADER=

# Optional webMAN mount URL template. Omit to show mount as unavailable.
# The application never launches a game.
PS3_MOUNT_URL_TEMPLATE=
